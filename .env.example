# Salin menjadi .env.local untuk uji lokal (npm run dev). JANGAN di-commit.
# Di Vercel, isi variabel yang sama lewat Settings → Environment Variables.

# API key dari https://console.anthropic.com (Settings → API Keys)
ANTHROPIC_API_KEY=

# Kode akses kantor (bebas, minimal 8 karakter) — diminta saat pertama memberi tugas
OFFICE_PASSCODE=

# 1 = mode uji tanpa memanggil Claude (tanpa biaya). Kosongkan untuk produksi.
MOCK_API=
